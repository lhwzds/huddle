# Copy to .env (never commit it). Everything except the model key is optional:
# an unset setting switches its feature off, so a local setup works with just a key.

# ---- model ---------------------------------------------------------------------------------
# A key of `models` in config/huddle.yaml: deepseek, minimax, openai, openai-plan or fake (no key needed).
HUDDLE_MODEL=deepseek
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
OPENAI_API_KEY=
# For `openai-plan` (Responses API with a short-lived token file instead of a key): the path inside the
# backend container; see docs/configuration.md for mounting the file.
OPENAI_TOKEN_FILE=
# OPENAI_MODEL=gpt-6.1-terra
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- serving ---------------------------------------------------------------------------------
# Host port of the web app.
HUDDLE_PORT=8080
# Interface the port listens on: this machine only by default. Set 0.0.0.0 (or a LAN address) to serve other
# machines; behind a proxy, use an address only the proxy can reach.
HUDDLE_BIND=127.0.0.1
# Serve under a path when a reverse proxy strips it (must start and end with /). Rebuild the frontend after changing.
HUDDLE_BASE_PATH=/
# Path of the invite cookie; usually the same as HUDDLE_BASE_PATH.
HUDDLE_COOKIE_PATH=/
# Number of reverse proxies in front of port 8080 (each appends to X-Forwarded-For). Leave empty when
# browsers connect directly. Per-client limits and the Secure cookie depend on it being right, and on the
# port being reachable by nothing but the proxy.
HUDDLE_TRUST_PROXY=

# ---- protecting a public instance --------------------------------------------------------------
# Invite code: when set, every /api route needs the cookie that a link with ?code=... sets.
HUDDLE_ACCESS_CODE=
# Per client (IP): messages per minute / per day, new conversations and new members per day.
HUDDLE_RATE_MESSAGES_PER_MIN=
HUDDLE_RATE_MESSAGES_PER_DAY=
HUDDLE_RATE_CONVERSATIONS_PER_DAY=
HUDDLE_RATE_AGENTS_PER_DAY=
# User messages per conversation, and conversations that may run at the same time.
HUDDLE_MAX_MESSAGES_PER_CONVERSATION=
HUDDLE_MAX_ACTIVE_CONVERSATIONS=
# Model tokens the whole instance may spend per UTC day.
HUDDLE_DAILY_TOKEN_BUDGET=

# ---- sandbox -----------------------------------------------------------------------------------
# Delete idle workspaces after this many hours (0 keeps them), and a best-effort disk budget per workspace in MB
# (checked every second while a command runs; see SECURITY.md).
HUDDLE_WORKSPACE_TTL_HOURS=24
HUDDLE_WORKSPACE_MAX_MB=50

# ---- advanced --------------------------------------------------------------------------------
# HUDDLE_CONFIG=/app/config/huddle.yaml      other config file
# HUDDLE_LANGUAGE_FILE=language.yaml         other intent word lists (relative to the config folder)
# HUDDLE_SEARCH_URL=https://html.duckduckgo.com/html/
